---
interface Props { nome: string }
const { nome } = Astro.props
---
<svg class="ic" viewBox="0 0 48 48" fill="none" stroke="currentColor" stroke-width="1.4" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
  {nome === 'sol' && (<><circle cx="24" cy="26" r="11" /><path d="M4 38h40M12 43h24M24 7v5M9 13l3.5 3.5M39 13l-3.5 3.5" /></>)}
  {nome === 'curva' && (<><path d="M6 42h36M6 42V6" /><path d="M8 38c10-1 18-6 24-16s8-14 10-16" /><circle cx="42" cy="6" r="1.6" fill="currentColor" /></>)}
  {nome === 'taxa' && (<><path d="M6 42h36" /><path d="M8 36c12-2 20-8 32-22" /><path d="M8 38c12-1 19-4 32-12" stroke-dasharray="3 3" /><path d="M34 8l6 6M40 8l-6 6" /></>)}
  {nome === 'balanca' && (<><path d="M24 6v34M14 40h20M10 12h28" /><path d="M10 12l-6 12h12zM38 12l-6 12h12z" /></>)}
  {nome === 'escudo' && (<><path d="M24 5l15 6v11c0 10-6 17-15 21C15 39 9 32 9 22V11z" /><path d="M18 24l5 5 8-10" /></>)}
  {nome === 'alvo' && (<><circle cx="24" cy="24" r="18" /><circle cx="24" cy="24" r="11" /><circle cx="24" cy="24" r="4" /><path d="M24 24l16-16M34 6l6 2 2 6" /></>)}
  {nome === 'casa' && (<><path d="M6 22L24 7l18 15M11 18v22h26V18" /><path d="M20 40V28h8v12" /></>)}
  {nome === 'cofre' && (<><rect x="6" y="9" width="36" height="30" rx="2" /><circle cx="24" cy="24" r="7" /><path d="M24 17v3M24 28v3M17 24h3M28 24h3M10 39v3M38 39v3" /></>)}
  {nome === 'cartao' && (<><rect x="5" y="11" width="38" height="26" rx="3" /><path d="M5 18h38M11 30h8M27 30h10" /></>)}
  {nome === 'termometro' && (<><path d="M20 30V8a4 4 0 0 1 8 0v22a8 8 0 1 1-8 0z" /><path d="M24 14v20M32 12h6M32 18h4M32 24h6" /></>)}
  {nome === 'faisca' && (<><path d="M22 6c1.5 8 4 11.5 12 13-8 1.5-10.5 5-12 13-1.5-8-4-11.5-12-13 8-1.5 10.5-5 12-13z" /><path d="M37 28c.7 3.6 1.8 5.2 5.4 5.9-3.6.7-4.7 2.3-5.4 5.9-.7-3.6-1.8-5.2-5.4-5.9 3.6-.7 4.7-2.3 5.4-5.9zM10 34l1 3 3 1-3 1-1 3-1-3-3-1 3-1z" /></>)}
  {nome === 'lupa' && (<><circle cx="21" cy="21" r="12" /><path d="M30 30l12 12M21 15v7M21 26v.5" /></>)}
</svg>
<style>.ic { width: 100%; height: 100%; }</style>
