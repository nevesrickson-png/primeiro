---
import { render } from 'astro:content'
import Base from '../../layouts/Base.astro'
import PaginaLista from '../../components/PaginaLista.astro'
import Capa from '../../components/Capa.astro'
import Meta from '../../components/Meta.astro'
import CartaMensal from '../../components/CartaMensal.astro'
import GradeArtigos from '../../components/GradeArtigos.astro'
import Simbolo from '../../components/Simbolo.astro'
import { CATEGORIAS, SITE, type Categoria } from '../../config'
import { artigosPublicados, type Artigo } from '../../lib/artigos'

// Uma rota atende as categorias (/artigos/protecao) e os artigos (/artigos/<titulo>).
export async function getStaticPaths() {
  const artigos = await artigosPublicados()
  const categorias = (Object.keys(CATEGORIAS) as Categoria[]).map((c) => ({
    params: { slug: c },
    props: { tipo: 'categoria' as const, categoria: c, artigos: artigos.filter((a) => a.data.categoria === c) }
  }))
  const paginas = artigos.map((a) => ({
    params: { slug: a.id },
    props: {
      tipo: 'artigo' as const,
      artigo: a,
      relacionados: artigos.filter((b) => b.id !== a.id && b.data.categoria === a.data.categoria).slice(0, 3)
    }
  }))
  return [...categorias, ...paginas]
}

type Props =
  | { tipo: 'categoria'; categoria: Categoria; artigos: Artigo[] }
  | { tipo: 'artigo'; artigo: Artigo; relacionados: Artigo[] }
const p = Astro.props
const artigo = p.tipo === 'artigo' ? p.artigo : null
const conteudo = artigo ? await render(artigo) : null
const url = new URL(Astro.url.pathname, Astro.site).toString()
const cat = artigo ? CATEGORIAS[artigo.data.categoria] : null
---
{p.tipo === 'categoria' ? (
  <PaginaLista
    tituloPagina={CATEGORIAS[p.categoria].titulo}
    titulo={`${CATEGORIAS[p.categoria].titulo}`}
    chapeu="Análises"
    apoio={`${CATEGORIAS[p.categoria].porque} ${CATEGORIAS[p.categoria].texto}`}
    descricao={`${CATEGORIAS[p.categoria].titulo}: ${CATEGORIAS[p.categoria].texto}`}
    artigos={p.artigos}
    atual={p.categoria}
  />
) : artigo && conteudo && cat && (
  <Base titulo={artigo.data.titulo} descricao={artigo.data.resumo} tipo="article" publicado={artigo.data.data} imagem={artigo.data.capa ?? '/og.png'} semIndice={artigo.data.rascunho}>
    <div class="leitura-barra" aria-hidden="true"></div>
    <article class="artigo">
      <header class="wrap artigo__cab">
        <a class="chapeu chapeu--filete" href={`/artigos/${artigo.data.categoria}`}>{cat.nome}</a>
        <h1 class="titulo artigo__titulo">{artigo.data.titulo}</h1>
        <p class="apoio">{artigo.data.resumo}</p>
        <div class="artigo__autor">
          {SITE.avatar ? (
            <picture class="artigo__avatar"><source type="image/webp" srcset={`${SITE.avatar}.webp`} /><img src={`${SITE.avatar}.jpg`} alt="" width="48" height="48" /></picture>
          ) : (
            <span class="artigo__avatar" aria-hidden="true"><Simbolo sol={false} horizonte={false} pesos={[3, 1.2, 1]} rotulo="" /></span>
          )}
          <div><strong>Por Rickson Messias</strong><Meta artigo={artigo} /></div>
        </div>
      </header>
      <div class="wrap artigo__capa"><Capa capa={artigo.data.capa} alt={artigo.data.capa_alt} categoria={artigo.data.categoria} grande /></div>
      <div class="wrap artigo__corpo">
        {artigo.data.em_resumo && (
          <aside class="caixa caixa--resumo"><p class="chapeu">Em resumo</p><p>{artigo.data.em_resumo}</p></aside>
        )}
        <div class="prosa"><conteudo.Content /></div>
        {artigo.data.categoria === 'protecao' && (
          <aside class="caixa caixa--alerta">
            {artigo.data.sinais && artigo.data.sinais.length > 0 && (
              <>
                <p class="chapeu">Sinais de alerta</p>
                <ul>{artigo.data.sinais.map((s) => <li>{s}</li>)}</ul>
              </>
            )}
            <p class="chapeu">Antes de investir</p>
            <p>Confira se a empresa é autorizada pela CVM ou pelo Banco Central, desconfie de retorno fixo e alto, nunca transfira dinheiro para conta de pessoa física e, na dúvida, pergunte a alguém de confiança antes de decidir.</p>
          </aside>
        )}
        <p class="artigo__reg">{SITE.rodapeRegulatorio}</p>
        <div class="artigo__compartilhar">
          <span class="chapeu">Compartilhar</span>
          <a href={`https://wa.me/?text=${encodeURIComponent(artigo.data.titulo + ' ' + url)}`} target="_blank" rel="noopener">WhatsApp</a>
          <a href={`https://www.linkedin.com/sharing/share-offsite/?url=${encodeURIComponent(url)}`} target="_blank" rel="noopener">LinkedIn</a>
          <button type="button" data-copiar={url}>Copiar link</button>
        </div>
        <div class="artigo__sobre">
          <p><strong>Rickson Messias</strong> é assessor de investimentos certificado CEA e criador do @ofilhomaisrico.</p>
          <a class="link link--sub" href="/sobre">Conhecer minha história <span class="seta">→</span></a>
        </div>
        <div class="artigo__conversa">
          <p>Quer olhar esse tema para o seu caso?</p>
          <a class="link link--sub" href="/assessoria#agendar">Vamos conversar <span class="seta">→</span></a>
        </div>
      </div>
    </article>
    <section class="secao secao--escura"><div class="wrap"><CartaMensal escuro titulo="Gostou? Receba a carta do mês." /></div></section>
    {p.tipo === 'artigo' && p.relacionados.length > 0 && (
      <section class="secao">
        <div class="wrap">
          <div class="cab-secao cab-secao--simples"><div><p class="chapeu">{cat.nome}</p><h2 class="titulo">Leia também</h2></div></div>
          <GradeArtigos artigos={p.relacionados} />
        </div>
      </section>
    )}
  </Base>
)}

<style>
  .artigo__cab { max-width: 860px; padding-top: clamp(56px, 8vw, 96px); display: grid; gap: 22px; justify-items: start; }
  .artigo__titulo { font-size: clamp(36px, 5vw, 64px); line-height: 1.06; }
  .artigo__autor { display: flex; align-items: center; gap: 14px; margin-top: 8px; }
  .artigo__autor :global(.meta) { margin-top: 2px; }
  .artigo__avatar { width: 48px; height: 48px; border-radius: 50%; background: var(--tinta); display: grid; place-items: center; }
  .artigo__avatar :global(.simbolo) { width: 30px; }
  .artigo__avatar { overflow: hidden; flex: none; }
  .artigo__avatar img { width: 100%; height: 100%; object-fit: cover; }
  .artigo__capa { max-width: 1040px; margin-top: 48px; }
  .artigo__corpo { max-width: var(--leitura); padding: 56px 0 96px; }
  .caixa { padding: 28px 30px; margin: 0 0 40px; }
  .caixa .chapeu { margin-bottom: 8px; }
  .caixa--resumo { background: var(--marfim-3); border-left: 2px solid var(--champ-p); font-size: 18px; }
  .caixa--alerta { background: var(--tinta); color: var(--marfim); margin-top: 48px; border-top: 2px solid var(--champ); }
  .caixa--alerta .chapeu { color: var(--champ); }
  .caixa--alerta ul { margin: 0 0 22px 20px; color: var(--aco-claro); }
  .caixa--alerta p:not(.chapeu) { color: var(--aco-claro); }
  .caixa--alerta li { margin-bottom: 6px; }
  .artigo__reg { font-size: 13px; color: var(--grafite); border-top: 1px solid var(--pedra); padding-top: 22px; margin-top: 48px; }
  .artigo__compartilhar { display: flex; align-items: center; gap: 18px; flex-wrap: wrap; margin-top: 28px; font-size: 14px; font-weight: 600; }
  .artigo__compartilhar a, .artigo__compartilhar button { background: none; border: 0; border-bottom: 1px solid var(--pedra); padding: 2px 0; cursor: pointer; }
  .artigo__compartilhar a:hover, .artigo__compartilhar button:hover { border-color: var(--champ-p); }
  .artigo__sobre, .artigo__conversa { display: flex; justify-content: space-between; align-items: center; gap: 20px; flex-wrap: wrap; padding: 24px 0; border-top: 1px solid var(--pedra); }
  .artigo__sobre { margin-top: 40px; }
  .artigo__conversa p { font-family: var(--serif); font-size: 20px; }

  /* Texto do artigo */
  .prosa { font-size: 19px; line-height: 1.75; color: #232c38; }
  .prosa :global(> * + *) { margin-top: 1.1em; }
  .prosa :global(h2) { font-family: var(--serif); font-weight: 400; font-size: 32px; line-height: 1.2; margin-top: 1.8em; color: var(--tinta); }
  .prosa :global(h3) { font-family: var(--serif); font-weight: 500; font-size: 24px; margin-top: 1.5em; color: var(--tinta); }
  .prosa :global(a) { color: var(--champ-p); text-decoration: underline; text-underline-offset: 3px; }
  .prosa :global(blockquote) { font-family: var(--serif); font-style: italic; font-size: 26px; line-height: 1.35; border-left: 2px solid var(--champ); padding-left: 24px; color: var(--tinta); margin: 1.6em 0; }
  .prosa :global(ul), .prosa :global(ol) { padding-left: 1.3em; }
  /* Tabelas largas rolam de lado no celular em vez de estourar a página. */
  .prosa :global(table) { display: block; max-width: 100%; overflow-x: auto; }
  .prosa :global(li + li) { margin-top: 0.4em; }
  .prosa :global(strong) { color: var(--tinta); }
  .prosa :global(img) { margin: 1.6em 0; border-radius: var(--raio); }
  .prosa :global(table) { width: 100%; border-collapse: collapse; font-size: 16px; font-variant-numeric: tabular-nums; }
  .prosa :global(th), .prosa :global(td) { text-align: left; padding: 10px 12px; border-bottom: 1px solid var(--pedra); }
  .prosa :global(th) { font-weight: 600; border-bottom: 2px solid var(--tinta); }
  .prosa :global(hr) { border: 0; border-top: 1px solid var(--pedra); margin: 2em 0; }
  @media (max-width: 640px) { .prosa { font-size: 17.5px; } .prosa :global(h2) { font-size: 27px; } }
</style>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copiar]').forEach((b) => {
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(b.dataset.copiar ?? location.href)
        b.textContent = 'Link copiado'
        setTimeout(() => (b.textContent = 'Copiar link'), 2000)
      } catch {
        prompt('Copie o link:', b.dataset.copiar ?? location.href)
      }
    })
  })
</script>
