---
import Base from '../layouts/Base.astro'
import AberturaPagina from '../components/AberturaPagina.astro'
import Aceite from '../components/Aceite.astro'
import { SITE } from '../config'

const publicos = [
  ['Empresários', 'O patrimônio pessoal costuma se misturar ao do negócio, o tempo é curto e as decisões são grandes. O trabalho aqui é dar estrutura, liquidez e pensar na sucessão.'],
  ['Profissionais liberais', 'Renda alta e muitas vezes variável, sem a previdência de uma empresa por trás. O trabalho aqui é criar método para transformar renda em patrimônio.'],
  ['Aposentados e investidores conservadores', 'A prioridade é segurança, previsibilidade e renda. O trabalho aqui é dar clareza e mostrar riscos que nem sempre estão à vista.']
]
const passos = [
  ['Conversa inicial', 'Eu escuto antes de falar. Seus objetivos, seu momento, o que você já tem e o que te preocupa.'],
  ['Diagnóstico e perfil', 'Entendemos juntos seu perfil de investidor e o prazo de cada objetivo.'],
  ['Estratégia', 'Uma carteira diversificada, coerente com o seu perfil, com cada risco explicado antes de qualquer decisão.'],
  ['Acompanhamento', 'Revisões periódicas e contato próximo. Quando algo muda na sua vida ou no mercado, a gente conversa.']
]
const diferenciais = [
  ['Cuidado de quem construiu', 'Sei quanto custa cada degrau. Trato o seu patrimônio como se fosse o único que eu tenho.'],
  ['Profundidade técnica', 'CEA em nove meses, CFP em preparação e conversa direta com gestores e estrategistas.'],
  ['Olho treinado contra fraudes', 'Anos estudando pirâmides e golpes. Reconheço a promessa que não fecha e ensino você a reconhecer também.'],
  ['Tecnologia própria', 'Ferramentas que eu mesmo construí para acompanhar cada cliente de perto.']
]
const esperar = [
  ['Explicação clara, sem jargão', 'Promessa de rentabilidade'],
  ['Riscos ditos antes do retorno', 'Pressão para decidir'],
  ['Atendimento próximo e pessoal', '“Oportunidade única”'],
  ['Opinião com fonte e data', 'Produto empurrado']
]
// "Quanto custa ter um assessor?" entra quando a redação for aprovada pelo compliance da EQI.
const perguntas = [
  ['Como funciona o vínculo com a EQI?', 'Sou assessor de investimentos vinculado à EQI Investimentos. Seus investimentos ficam em uma conta em seu nome no BTG Pactual, a instituição custodiante, e eu acompanho a sua carteira e te oriento nas decisões.'],
  ['Existe valor mínimo para começar?', 'Sim. A assessoria é indicada para quem tem a partir de R$ 500 mil para investir. É o patamar em que consigo dedicar a atenção que cada patrimônio merece.'],
  ['O meu dinheiro fica com você?', 'Não. O dinheiro fica sempre em conta em seu nome, no BTG Pactual. Eu nunca recebo recursos de clientes em conta própria. Se alguém pedir isso, desconfie: é um dos sinais clássicos de golpe.'],
  ['Como é a primeira conversa?', 'Uma conversa de cerca de uma hora, por vídeo ou presencialmente. Eu escuto mais do que falo. Não há compromisso: se fizer sentido, seguimos. Se não, você sai com mais clareza do que entrou.']
]
const perfis = ['Empresário', 'Profissional liberal', 'Aposentado', 'Outro']
const origens = ['Instagram', 'YouTube', 'LinkedIn', 'Indicação', 'Evento', 'Google', 'Outro']
---
<Base titulo="Assessoria de investimentos" descricao="Assessoria de investimentos para empresários, profissionais liberais e aposentados que pensam no longo prazo. Primeiro proteger, depois crescer.">
  <AberturaPagina chapeu="Assessoria de investimentos" titulo="Primeiro proteger. <em>Depois crescer.</em>" apoio="Acompanho o patrimônio de quem construiu cada degrau com esforço, com método, transparência e visão de décadas.">
    <div class="acoes rv" data-d="300"><a class="btn btn--champ" href="#agendar">Agendar conversa <span class="seta">→</span></a></div>
  </AberturaPagina>

  <section class="secao">
    <div class="wrap">
      <div class="cab-secao cab-secao--simples"><div><p class="chapeu">Para quem</p><h2 class="titulo">Para quem pensa em décadas</h2></div></div>
      <div class="grade-3">
        {publicos.map(([t, d], i) => (<div class="cartao rv" data-d={String(i * 100)}><p class="numero">{String(i + 1).padStart(2, '0')}</p><h3>{t}</h3><p>{d}</p></div>))}
      </div>
    </div>
  </section>

  <section class="secao secao--clara-2">
    <div class="wrap">
      <div class="cab-secao cab-secao--simples"><div><p class="chapeu">Como trabalho</p><h2 class="titulo">Quatro passos, sem atalho</h2></div></div>
      <ol class="grade-4 passos">
        {passos.map(([t, d], i) => (<li class="numerado rv" data-d={String(i * 100)}><p class="numero">{i + 1}</p><h3>{t}</h3><p>{d}</p></li>))}
      </ol>
    </div>
  </section>

  <section class="secao">
    <div class="wrap">
      <div class="cab-secao cab-secao--simples"><div><p class="chapeu">Por que comigo</p><h2 class="titulo">Quatro razões para conversar</h2></div></div>
      <div class="grade-4">
        {diferenciais.map(([t, d], i) => (<div class="numerado rv" data-d={String(i * 100)}><p class="numero">{String(i + 1).padStart(2, '0')}</p><h3>{t}</h3><p>{d}</p></div>))}
      </div>
    </div>
  </section>

  <section class="secao secao--escura">
    <div class="wrap">
      <h2 class="titulo esperar__titulo">O que você pode esperar de mim</h2>
      <div class="esperar">
        <div><p class="chapeu">Pode esperar</p><ul>{esperar.map(([s]) => <li class="sim">{s}</li>)}</ul></div>
        <div><p class="chapeu">Não vai encontrar</p><ul>{esperar.map(([, n]) => <li class="nao">{n}</li>)}</ul></div>
      </div>
    </div>
  </section>

  <section class="secao">
    <div class="wrap faq">
      <div><p class="chapeu">Perguntas frequentes</p><h2 class="titulo">Antes de conversar</h2></div>
      <div class="faq__lista">
        {perguntas.map(([p, r]) => (
          <details class="rv"><summary>{p}<span aria-hidden="true">+</span></summary><p>{r}</p></details>
        ))}
      </div>
    </div>
  </section>

  <section class="secao secao--clara-2" id="agendar">
    <div class="wrap agendar">
      <div class="agendar__texto">
        <p class="chapeu">Agendar conversa</p>
        <h2 class="titulo">Vamos conversar</h2>
        <p class="apoio">Preencha abaixo e eu retorno em {SITE.prazoRetorno} para combinar o melhor horário.</p>
        <p class="aviso">A assessoria é indicada para patrimônios a partir de R$ 500 mil.</p>
      </div>
      <form class="form agendar__form" data-formulario="agendar" data-sucesso="/obrigado">
        <div class="campo"><label for="ag-nome">Seu nome</label><input id="ag-nome" name="nome" autocomplete="name" required maxlength="120" /></div>
        <div class="linha-2">
          <div class="campo"><label for="ag-email">Seu e-mail</label><input id="ag-email" type="email" name="email" autocomplete="email" required /></div>
          <div class="campo"><label for="ag-whats">WhatsApp com DDD</label><input id="ag-whats" type="tel" name="whatsapp" autocomplete="tel" inputmode="tel" required pattern="[0-9()+\s.\-]{10,20}" placeholder="(21) 99999-9999" /></div>
        </div>
        <div class="linha-2">
          <div class="campo"><label for="ag-cidade">Cidade <span class="opc">(opcional)</span></label><input id="ag-cidade" name="cidade" autocomplete="address-level2" /></div>
          <div class="campo"><label for="ag-prof">Profissão <span class="opc">(opcional)</span></label><input id="ag-prof" name="profissao" autocomplete="organization-title" /></div>
        </div>
        <div class="linha-2">
          <div class="campo"><label for="ag-perfil">Você é… <span class="opc">(opcional)</span></label>
            <select id="ag-perfil" name="perfil"><option value="">Selecione</option>{perfis.map((p) => <option>{p}</option>)}</select></div>
          <div class="campo"><label for="ag-orig">Como me conheceu? <span class="opc">(opcional)</span></label>
            <select id="ag-orig" name="como_conheceu"><option value="">Selecione</option>{origens.map((o) => <option>{o}</option>)}</select></div>
        </div>
        <div class="campo"><label for="ag-msg">O que você gostaria de conversar? <span class="opc">(opcional)</span></label><textarea id="ag-msg" name="mensagem" maxlength="2000"></textarea></div>
        <Aceite id="ag-lgpd" />
        <div class="agendar__envio">
          <button class="btn btn--tinta" type="submit">Enviar <span class="seta">→</span></button>
          <p class="nota">Não peço dados financeiros por aqui. Esses assuntos ficam para a conversa.</p>
        </div>
        <p class="form-status" data-status role="status" aria-live="polite"></p>
      </form>
    </div>
  </section>

  <section class="secao reg">
    <div class="wrap"><p>Rickson Messias é assessor de investimentos vinculado à EQI Investimentos, nos termos da regulamentação da CVM. A assessoria não garante rentabilidade. Investimentos envolvem riscos, inclusive de perda do capital. Rentabilidade passada não é garantia de rentabilidade futura.</p></div>
  </section>
</Base>

<style>
  .passos { list-style: none; }
  .esperar__titulo { margin-bottom: 40px; }
  .esperar { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; }
  .esperar ul { list-style: none; margin-top: 18px; }
  .esperar li { padding: 18px 0 18px 36px; border-top: 1px solid var(--linha-escura); position: relative; font-size: 18px; }
  .esperar li::before { position: absolute; left: 0; top: 17px; font-weight: 600; }
  .sim::before { content: '✓'; color: var(--champ); }
  .nao { color: var(--aco); }
  .nao::before { content: '✕'; color: var(--aco); }

  .faq { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: 64px; }
  .faq .titulo { margin-top: 12px; }
  .faq__lista { border-top: 2px solid var(--tinta); }
  details { border-bottom: 1px solid var(--pedra); }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: 24px; padding: 24px 0; font-family: var(--serif); font-size: 22px; line-height: 1.3; }
  summary::-webkit-details-marker { display: none; }
  summary span { color: var(--champ-p); font-family: var(--sans); font-size: 26px; line-height: 1; transition: transform 0.3s var(--ease); }
  details[open] summary span { transform: rotate(45deg); }
  details p { color: var(--grafite); padding: 0 48px 26px 0; }

  .agendar { display: grid; grid-template-columns: 0.8fr 1.2fr; gap: clamp(40px, 6vw, 80px); align-items: start; }
  .agendar__texto { display: grid; gap: 18px; position: sticky; top: calc(var(--cab-altura) + 32px); }
  .aviso { border-left: 2px solid var(--champ-p); padding-left: 16px; font-weight: 600; font-size: 15px; }
  .agendar__form { background: var(--marfim-2); border: 1px solid var(--pedra); padding: clamp(24px, 4vw, 44px); }
  .agendar__envio { display: flex; align-items: center; gap: 20px; flex-wrap: wrap; }
  .nota { font-size: 13px; color: var(--grafite); max-width: 300px; }
  .reg { padding: 40px 0; }
  .reg p { font-size: 13px; color: var(--grafite); max-width: 900px; }

  @media (max-width: 860px) {
    .esperar, .faq, .agendar { grid-template-columns: 1fr; gap: 32px; }
    .agendar__texto { position: static; }
    details p { padding-right: 0; }
  }
</style>
