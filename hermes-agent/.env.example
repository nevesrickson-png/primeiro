# Copie para .env e preencha. O .env NUNCA deve ir para o Git.

# ---- Versão da imagem -------------------------------------------------------
# "latest" ou uma versão fixa (ex.: v2026.9.21) para não mudar sem você querer.
HERMES_TAG=latest

# ---- Chave do modelo de IA (preencha pelo menos uma) ------------------------
# O assistente "setup" também pode gravar as chaves em dados/.env.
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
OPENAI_API_KEY=

# ---- Painel web (porta 9119) ------------------------------------------------
# Obrigatório: o painel guarda suas chaves de API. Use uma senha forte.
HERMES_DASHBOARD_BASIC_AUTH_USERNAME=admin
HERMES_DASHBOARD_BASIC_AUTH_PASSWORD=troque-esta-senha
# Mantém o login após reiniciar (gere com: openssl rand -hex 32)
HERMES_DASHBOARD_BASIC_AUTH_SECRET=

# ---- API compatível com OpenAI (porta 8642, opcional) -----------------------
# API_SERVER_ENABLED=true
# API_SERVER_HOST=0.0.0.0
# API_SERVER_KEY=        # obrigatório se ativar (openssl rand -hex 32)

# ---- Rede --------------------------------------------------------------------
# 127.0.0.1 = só este computador. NÃO troque para 0.0.0.0 numa VPS.
BIND_ADDR=127.0.0.1
DASHBOARD_PORT=9119
API_PORT=8642

# ---- Recursos ------------------------------------------------------------------
LIMITE_MEMORIA=4G
LIMITE_CPUS=2.0
